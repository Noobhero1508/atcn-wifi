    <string name="settings_title">Settings</string>
    <string name="connection_section">Connection</string>
    <string name="check_frequency">Adaptive checks · Balanced</string>
    <string name="check_frequency_description">Screen on: 5 seconds. Screen off for under 2 minutes: 10 seconds; afterwards: 30 seconds. Screen on triggers an immediate check. Android can defer checks during deep sleep.</string>
    <string name="priority_title">Prioritize continuous connection</string>
    <string name="priority_description">Keep the planned 5-second interval with the screen off, useful for calls or music. Uses more battery and remains subject to Android background limits.</string>
    <string name="priority_accessibility">Prioritize continuous connection</string>
