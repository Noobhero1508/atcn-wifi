    <string name="mobile_data_title">Use 4G/5G when Wi‑Fi loses Internet</string>
    <string name="mobile_data_description">Keep mobile data on. On Samsung: Wi‑Fi → ⋮ → Intelligent Wi‑Fi → Switch to mobile data (if available). Android decides when to switch; ATCN Wifi still signs in over Wi‑Fi and cannot guarantee uninterrupted calls during a switch.</string>
    <string name="open_wifi_settings">Open Wi‑Fi settings</string>
    <string name="compatibility_title">AWING compatibility mode</string>
    <string name="compatibility_description">Only when the standard flow fails, send View/Click events to AWING as if you used the portal. Off by default.</string>
    <string name="compatibility_accessibility">Enable AWING compatibility mode</string>

    <string name="battery_section">Background &amp; battery</string>
    <string name="battery_title">Allow reliable background work</string>
    <string name="battery_description">ATCN Wifi only runs in the background while Auto monitoring is enabled. Samsung may put the app to sleep; if reconnection is delayed, set battery usage to Unrestricted.</string>
    <string name="open_battery_settings">Open battery settings</string>
    <string name="notification_title">Monitoring notification</string>
    <string name="notification_description">Android requires a persistent notification so monitoring can continue while the screen is off.</string>
    <string name="open_notification_settings">Notification settings</string>

    <string name="privacy_section">Privacy</string>
    <string name="privacy_title">Your data stays on this device</string>
    <string name="privacy_description">No account, ads, or first-party telemetry. Logs remain local and are shared only when you export them. Sign-in requests go directly to the MikroTik gateway and AWING.</string>
    <string name="privacy_http_note">The dorm portal uses HTTP. Cleartext is only enabled for the required gateway, AWING and captive-check destinations; Internet verification uses HTTPS.</string>

    <string name="notification_permission_title">Allow notifications</string>
    <string name="notification_permission_message">ATCN Wifi needs to show a persistent notification while Auto monitoring is running. You can stop it at any time from the app.</string>
    <string name="notification_permission_allow">Continue</string>
    <string name="notification_permission_denied">Notifications were denied. Auto monitoring still runs; Android shows the app under Active apps instead of the notification drawer.</string>
