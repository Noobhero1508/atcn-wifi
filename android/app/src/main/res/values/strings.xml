    <string name="no_periodic_check">Chưa chạy kiểm tra định kỳ</string>
    <string name="mobile_data_title">Dùng 4G/5G khi Wi‑Fi mất Internet</string>
    <string name="mobile_data_description">Giữ dữ liệu di động bật. Trên Samsung: Wi‑Fi → ⋮ → Intelligent Wi‑Fi → Chuyển sang dữ liệu di động (nếu có). Android quyết định chuyển mạng; ATCN Wifi vẫn đăng nhập qua Wi‑Fi và không bảo đảm cuộc gọi liền mạch khi chuyển mạng.</string>
    <string name="open_wifi_settings">Mở cài đặt Wi‑Fi</string>
    <string name="compatibility_title">Chế độ tương thích AWING</string>
    <string name="compatibility_description">Chỉ khi cách chuẩn thất bại, gửi sự kiện View/Click tới AWING như khi bạn thao tác trên portal. Mặc định tắt.</string>
    <string name="compatibility_accessibility">Bật chế độ tương thích AWING</string>

    <string name="battery_section">Hoạt động nền &amp; pin</string>
    <string name="battery_title">Cho phép chạy ổn định</string>
    <string name="battery_description">ATCN Wifi chỉ chạy nền khi bạn bật Tự động theo dõi. Samsung có thể đưa ứng dụng vào chế độ ngủ; nếu kết nối lại chậm, hãy đặt ứng dụng thành Không hạn chế trong cài đặt pin.</string>
    <string name="open_battery_settings">Mở cài đặt pin</string>
    <string name="notification_title">Thông báo theo dõi</string>
    <string name="notification_description">Android yêu cầu thông báo cố định để ứng dụng tiếp tục theo dõi khi tắt màn hình.</string>
    <string name="open_notification_settings">Cài đặt thông báo</string>

    <string name="privacy_section">Quyền riêng tư</string>
    <string name="privacy_title">Dữ liệu ở lại trên thiết bị</string>
    <string name="privacy_description">Không có tài khoản, quảng cáo hay telemetry riêng. Nhật ký được lưu cục bộ và chỉ được chia sẻ khi bạn chủ động xuất. Yêu cầu đăng nhập được gửi trực tiếp đến gateway MikroTik và AWING.</string>
    <string name="privacy_http_note">Portal KTX dùng HTTP. Kết nối không mã hóa chỉ được mở cho gateway, AWING và các địa chỉ nhận diện captive portal cần thiết; xác nhận Internet dùng HTTPS.</string>

    <string name="notification_permission_title">Cho phép thông báo</string>
    <string name="notification_permission_message">ATCN Wifi cần hiển thị một thông báo cố định khi Tự động theo dõi đang chạy. Bạn vẫn có thể dừng ngay từ ứng dụng.</string>
    <string name="notification_permission_allow">Tiếp tục</string>
    <string name="notification_permission_denied">Thông báo đã bị từ chối. Tự động theo dõi vẫn chạy; Android sẽ hiển thị ứng dụng trong mục Ứng dụng đang hoạt động thay vì ngăn thông báo.</string>
