    <string name="check_frequency">Kiểm tra thích ứng · Cân bằng</string>
    <string name="check_frequency_description">Màn hình sáng: 5 giây. Tắt màn hình dưới 2 phút: 10 giây; sau đó: 30 giây. Bật màn hình sẽ kiểm tra ngay. Android có thể trì hoãn kiểm tra khi máy ngủ sâu.</string>
    <string name="priority_title">Ưu tiên kết nối liên tục</string>
    <string name="priority_description">Giữ chu kỳ dự kiến 5 giây khi tắt màn hình, phù hợp lúc gọi hoặc nghe nhạc. Hao pin hơn và vẫn chịu giới hạn chạy nền của Android.</string>
